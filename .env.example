# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=heartbeat-readings

# PostgreSQL (Docker container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=heartbeat_db
POSTGRES_USER=heartbeat_user
POSTGRES_PASSWORD=change_me

# Kafka consumer
KAFKA_CONSUMER_GROUP=heartbeat-consumer-group

# Simulation
NUM_CUSTOMERS=10
SEND_INTERVAL_SECONDS=1.0
ANOMALY_RATE=0.05
INVALID_RATE=0.02

# Logging
LOG_LEVEL=INFO